{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-handoff-manager/project-identity.schema.json",
  "title": "项目身份",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_name",
    "revision",
    "official_location",
    "state",
    "last_computer",
    "last_operation",
    "last_updated"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "project_id": { "type": "string", "format": "uuid" },
    "project_name": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "official_location": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["local_active", "local_paused", "on_t9", "completed_on_t9", "transfer_incomplete", "cleanup_pending", "conflict"]
    },
    "last_computer": { "type": "string" },
    "last_operation": { "type": "string" },
    "last_updated": { "type": "string", "format": "date-time" }
  }
}
