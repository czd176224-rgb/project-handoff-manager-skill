{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-handoff-manager/environment.schema.json",
  "title": "项目环境清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capturedAt", "computerName", "platform", "tools", "dependencyFiles", "projectCache", "offlineDependencies"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "capturedAt": { "type": ["string", "null"], "format": "date-time" },
    "computerName": { "type": ["string", "null"] },
    "platform": { "type": "string" },
    "tools": { "type": "array", "items": { "type": "object" } },
    "dependencyFiles": { "type": "array", "items": { "type": "string" } },
    "projectCache": { "$ref": "#/$defs/inventory" },
    "offlineDependencies": { "$ref": "#/$defs/inventory" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "totalBytes", "available"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "lastModified": { "type": ["string", "null"], "format": "date-time" },
        "available": { "type": "boolean" }
      }
    }
  }
}
