{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-handoff-manager/environment.schema.json",
  "title": "项目环境清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capturedAt", "computerName", "platform", "tools", "dependencyFiles", "nodeEnvironment", "pythonEnvironment", "projectCache", "offlineDependencies"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "capturedAt": { "type": ["string", "null"], "format": "date-time" },
    "computerName": { "type": ["string", "null"] },
    "platform": { "type": "string" },
    "tools": { "type": "array", "items": { "type": "object" } },
    "dependencyFiles": { "type": "array", "items": { "type": "string" } },
    "nodeEnvironment": { "$ref": "#/$defs/nodeEnvironment" },
    "pythonEnvironment": { "$ref": "#/$defs/pythonEnvironment" },
    "projectCache": { "$ref": "#/$defs/inventory" },
    "offlineDependencies": { "$ref": "#/$defs/inventory" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "nodeEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dependenciesPresent", "lockFile", "recoveryCommand", "note"],
      "properties": {
        "status": { "type": "string", "enum": ["not_detected", "needs_restore", "present_needs_validation"] },
        "dependenciesPresent": { "type": "boolean" },
        "lockFile": { "type": ["string", "null"] },
        "recoveryCommand": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },
    "pythonEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "virtualEnvironmentPresent", "configurationFile", "originalPythonHome", "recoverySource", "recoveryCommand", "note"],
      "properties": {
        "status": { "type": "string", "enum": ["not_detected", "needs_restore", "needs_rebuild", "present_needs_validation"] },
        "virtualEnvironmentPresent": { "type": "boolean" },
        "configurationFile": { "type": ["string", "null"] },
        "originalPythonHome": { "type": ["string", "null"] },
        "recoverySource": { "type": ["string", "null"] },
        "recoveryCommand": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "totalBytes", "available"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "lastModified": { "type": ["string", "null"], "format": "date-time" },
        "available": { "type": "boolean" }
      }
    }
  }
}
